mixin publicacion(item,mensaje) 
  div.publicacion(data-post-id=item.id)
    style.
      .publicacion, .publicacion * {
        box-sizing: border-box;
      }
      .publicacion h1, .publicacion p, .publicacion li, .autor-publicacion {
        word-break: break-word;
        overflow-wrap: break-word;
        max-width: 100%;
      }
      #publicacionparteuno {
        overflow-y: auto;
      }
      .imagenes-contenedor {
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        width: 100%;
        height: 320px;
        margin-bottom: 20px;
        background-color: #fafafa;
        border-radius: 12px;
        padding: 10px;
        overflow: hidden;
        flex-shrink: 0;
      }
      .imagenPrincipal {
        max-width: 85%;
        max-height: 100%;
        width: auto;
        height: auto;
        object-fit: contain;
        display: block;
        margin: 0 auto;
        flex-shrink: 0;
      }
      .precioImagen {
        font-weight: bold;
      }

      .mostrar {
          display: none; /* Se vuelve 'flex' o 'block' con JS */
          position: fixed;
          top: 0;
          left: 0;
          width: 100%;
          height: 100%;
          background-color: rgba(0, 0, 0, 0.5); /* Fondo negro semitransparente */
          justify-content: center;
          align-items: center;
          z-index: 1000; /* Asegura que esté por encima de todo lo demás */
      }


    div#publicacionparteuno
      if item.creador
        a(href="/perfil/" + item.creador.id style="text-decoration: none; color: inherit;")
          p.autor-publicacion Creador de la publicación: #{item.creador.username}
        // Se mantiene fuera del tag <a> para evitar redirección
        p#seguirautor(style="cursor: pointer;") Seguir Autor
      else
        p.autor-publicacion Creador: Anónimo

      if item.imagenes && item.imagenes.length > 0 
        div.contadorImagenes 1 / #{item.imagenes.length}
        div.imagenes-contenedor
          img.btn-izquierda(src="/left.png" height="30px" style="cursor:pointer")
          img.imagenPrincipal(src="")
          img.btn-derecha(src="/right.png" height="30px" style="cursor:pointer")
        div.caracteristicas
          p.promedio Promedio: 0
          p.copyright
          p.precioImagen(style="display: none;")
          
          if usuario && (!item.creador || usuario.id != item.creador.id)
            div.bloqueValorar
              form(action="/crearValoracion" method="POST")
                input.inputImagenId2(type='hidden' name='imagen_id' value="")
                input.valordevalorar(type="range" min="1" max="10" value="5" name="valor")
                input(type='hidden' name='post_id' value=item.id)
                p.valorTexto Valor: 5
                input(type="submit" value="Valorar")
      else
        p Imagen no encontrada
          
      h1= item.titulo
      p= item.descripcion
      button.abrir reportar

      if item.etiquetas && item.etiquetas.length > 0
        ul
          each etq in item.etiquetas
            li= etq.nombre

    div.oculto
      dialog.reporte
        h2 formulario de reporte
        form.formulariodereporte(action="/denunciarImagen" method="POST")
          input.inputImagenDenuncia(type="hidden" name="imagen_id" value="")
          label(for="motivo") Motivo del reporte
          select#motivo(name="motivo" required)
            option(value="Copyright") Copyright
            option(value="Inapropiado") contenido inapropiado
          label(for="descripcion") Mas informacion
          textarea#descripcion(name="descripcion" required placeholder="Cuentanos mas")
          button(type="submit") Enviar


    div#publicacioncomentarios
      div
        h1 Comentarios
        if usuario && item.creador && usuario.id == item.creador.id
          form(action="/cambiarEstadoComentarios" method="POST")
            input(type="hidden" name="post_id" value=item.id)
            input.inputImagenComentarios(type="hidden" name="imagen_id" value="")
            button.botonEstadoComentarios(type="submit") Cambiar comentarios
          a(href="/misDenunciasComentarios") Revisar comentarios denunciados
        div.cajaComentarios

      p.mensajeEstadoComentarios
      if usuario
        form.formComentario(action='/crearComentario' method='POST')
          input(type='hidden' name='post_id' value=item.id)
          input.inputImagenId(type='hidden' name='imagen_id' value="")
          textarea(name='contenido' maxlength='255' required placeholder="Escribe un comentario...")
          input(type='submit' value='Comentar')
      else
        p Iniciá sesión para comentar.

    script.
      (function() {
        const imagenes = !{JSON.stringify(item.imagenes || [])};
        const creadorId = "!{item.creador ? item.creador.id : ''}";
        const usuarioActualId = !{usuario ? JSON.stringify(usuario.id) : 'null'};
        let index = 0;

        // variables
        const btnDerecha = document.querySelector(".btn-derecha");
        const btnIzquierda = document.querySelector(".btn-izquierda");
        const rangevoto = document.querySelector(".valordevalorar");
        const txtvoto = document.querySelector(".valorTexto");
        const elImagen = document.querySelector(".imagenPrincipal");
        const elPromedio = document.querySelector(".promedio");
        const elPrecio = document.querySelector(".precioImagen");
        const elContador = document.querySelector(".contadorImagenes");
        const cajaCmts = document.querySelector(".cajaComentarios");
        const inputsId = document.querySelectorAll(".inputImagenId, .inputImagenId2, .inputImagenDenuncia");
        const inputImagenComentarios = document.querySelector(".inputImagenComentarios");
        const formComentarios = document.querySelector(".formComentario");
        const mensajeEstadoComentarios = document.querySelector(".mensajeEstadoComentarios");
        const botonEstadoComentarios = document.querySelector(".botonEstadoComentarios");
        const seguirAutor = document.querySelector("#seguirautor");
        const reporte = document.querySelector(".reporte");
        const abrir = document.querySelector(".abrir");

        if (rangevoto && txtvoto) {
          rangevoto.addEventListener("input", function() {
            txtvoto.textContent = "Valor: " + rangevoto.value;
          });
        }

        // seguir a autor desde la publicacion
        if (seguirAutor) {
          seguirAutor.addEventListener("click", async function (event){
            event.preventDefault();
            try {
              if (creadorId) {
                const resultado = await fetch("/seguirUsuario/" + creadorId, {
                  method: 'POST'
                });
                
                if (resultado.ok) {
                  seguirAutor.textContent = "Siguiendo";
                }
              }
            } catch (error) {
              console.error("Error al seguir autor:", error);
            }
          });
        }

        function cargarDatos() {
          if (!imagenes.length || !elImagen) return;
          const img = imagenes[index];

          elImagen.src = img.url || img.ruta; 

          if (elPrecio) {
            const precio = img.Precio;
            elPrecio.textContent = precio !== null && precio !== undefined
              ? "Precio: $" + Number(precio).toLocaleString("es-AR")
              : "";
            elPrecio.style.display = precio !== null && precio !== undefined ? "block" : "none";
          }
          
          if (elContador) {
            elContador.textContent = (index + 1) + " / " + imagenes.length;
          }
          
          inputsId.forEach(function(input) {
            input.value = img.id || 0;
          });
          if (inputImagenComentarios) {
            inputImagenComentarios.value = img.id;
          }

          const comentariosPermitidos = Boolean(img.comentarios_permitidos);
          if (formComentarios) {
            formComentarios.hidden = !comentariosPermitidos;
          }
          if (mensajeEstadoComentarios) {
            mensajeEstadoComentarios.textContent = comentariosPermitidos
              ? ""
              : "El autor cerró los comentarios de esta imagen.";
          }
          if (botonEstadoComentarios) {
            botonEstadoComentarios.textContent = comentariosPermitidos
              ? "Cerrar comentarios de esta imagen"
              : "Abrir comentarios de esta imagen";
          }
          
          const votos = img.valoraciones || [];
          let suma = 0;
          for (let i = 0; i < votos.length; i++) {
            suma += Number(votos[i].puntaje);
          }

          let promedio = 0;
          if (votos.length > 0) {
            promedio = (suma / votos.length).toFixed(1);
          }

          if (elPromedio) {
            elPromedio.textContent = "Promedio: " + promedio + " | Valoraciones: " + votos.length;
          }
          
          if (rangevoto && txtvoto) {
            rangevoto.value = 5;
            txtvoto.textContent = "Valor: 5";
          }

          const comentarios = img.comentarios || [];
          cajaCmts.innerHTML = "";

          if (comentarios.length > 0) {
            comentarios.forEach(function(c) {
              const comentario = document.createElement("div");
              comentario.className = "comentario";

              const autor = document.createElement("strong");
              autor.textContent = (c.usuario ? c.usuario.username : "Anónimo") + ": ";
              comentario.appendChild(autor);

              const contenido = document.createElement("p");
              contenido.textContent = c.contenido;
              comentario.appendChild(contenido);

              if (usuarioActualId !== null &&
                  Number(c.user_id) !== Number(usuarioActualId) &&
                  Number(c.user_id) !== Number(creadorId)) {
                const formulario = document.createElement("form");
                formulario.method = "POST";
                formulario.action = "/denunciarComentario";

                const idComentario = document.createElement("input");
                idComentario.type = "hidden";
                idComentario.name = "comentario_id";
                idComentario.value = c.id;
                formulario.appendChild(idComentario);

                const motivo = document.createElement("select");
                motivo.name = "motivo";
                motivo.required = true;
                motivo.innerHTML = "<option value=''>Elegí un motivo</option>" +
                  "<option value='Inapropiado'>Contenido inapropiado</option>" +
                  "<option value='Spam'>Spam</option>" +
                  "<option value='Ofensivo'>Contenido ofensivo</option>" +
                  "<option value='Otro'>Otro</option>";
                formulario.appendChild(motivo);

                const descripcion = document.createElement("textarea");
                descripcion.name = "descripcion";
                descripcion.maxLength = 255;
                descripcion.required = true;
                descripcion.placeholder = "Explicá por qué denunciás este comentario";
                formulario.appendChild(descripcion);

                const enviarDenuncia = document.createElement("button");
                enviarDenuncia.type = "submit";
                enviarDenuncia.textContent = "Denunciar comentario";
                formulario.appendChild(enviarDenuncia);
                comentario.appendChild(formulario);
              }

              cajaCmts.appendChild(comentario);
            });
          } else {
            const mensaje = document.createElement("p");
            mensaje.textContent = "No hay comentarios aún.";
            cajaCmts.appendChild(mensaje);
          }
        }

        // carrusel
        if (imagenes.length) {
          if (btnIzquierda) {
            btnIzquierda.addEventListener("click", function() {
              index = (index - 1 + imagenes.length) % imagenes.length;
              cargarDatos();
            });
          }
          if (btnDerecha) {
            btnDerecha.addEventListener("click", function() {
              index = (index + 1) % imagenes.length;
              cargarDatos();
            });
          }
          cargarDatos();
        }

        // Abrir/cerrar modal de reporte
        if (abrir && reporte) {
          abrir.addEventListener("click", function() {
            reporte.showModal();
          });
        }
      })();