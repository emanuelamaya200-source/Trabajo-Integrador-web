mixin nav(className = "navc")
  ul(class=className)
    li
      a(href='/') Home
    li
      a(href='/explorar') Explorar
    li
      input#buscar(type="text", name="Buscar", placeholder="Buscar")
    li
      a(href='/crearPublicacion') Crear Publicación
    if usuario
      li
        a#perfil(href=`/perfil/${usuario.id}`) Ver Perfil
    if usuario.validador
      li
        details.menu-administrador
          summary Opciones de administrador
          div.opciones-administrador
            a(href="/denunciasComentarios") Denuncias de comentarios
            a(href="/denunciasImagenes") Denuncias de imágenes

  script.
    const buscar = document.querySelector("#buscar");
    if (buscar) {
      buscar.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' && buscar.value.trim()) {
          window.location.href = `/Buscar/${encodeURIComponent(buscar.value.trim())}`;
        }
      });
    }