extends ../layout 

block estilo
  style.
    * { box-sizing: border-box; }
    body {
      background-color: rgb(100, 100, 100);
      margin: 0;
      padding: 20px;
      color: white;
    }
    h1 { text-align: center; }
    #form {
      width: min(100%, 720px);
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 14px;
      border-radius: 5px;
      border: 3px solid rgb(100, 255, 100);
      padding: 15px;
    }
    #form > label, .opciones-imagen { display: flex; flex-direction: column; gap: 6px; }
    #zonaImagen {
      width: 100%;
      min-height: 150px;
      background-color: rgb(24, 26, 24);
      border-radius: 5px;
      border: 1px dashed rgb(100, 255, 100);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
    }
    #zonaImagen:hover, #zonaImagen.arrastrando { background-color: rgb(0, 43, 40); }
    #imagen { display: none; }
    #titulo, #descripcion, #etiqueta, .opciones-imagen input[type='text'], .opciones-imagen input[type='number'] {
      width: 100%;
      padding: 6px;
      border-radius: 4px;
      border: 1px solid rgb(100, 255, 100);
      background-color: rgb(0, 43, 40);
      color: white;
    }
    #descripcion {
      min-height: 120px;
      resize: none;
    }
    button {
      padding: 8px;
      border-radius: 4px;
      border: none;
      cursor: pointer;
      background-color: rgb(100, 255, 100);
      color: black;
    }
    #imagenesSeleccionadas { display: grid; gap: 10px; }
    .imagen-item {
      display: grid;
      grid-template-columns: 90px 1fr;
      gap: 10px;
      padding: 10px;
      border-radius: 4px;
      border: 1px solid rgb(100, 255, 100);
    }
    .imagen-item img { width: 90px; height: 90px; object-fit: cover; }
    .opciones-imagen { min-width: 0; }
    .opciones-imagen label { display: flex; gap: 6px; align-items: center; }
    #listaEtiquetas { display: flex; flex-wrap: wrap; gap: 8px; margin: 0; padding: 0; list-style: none; }
    @media (max-width: 520px) {
      body { padding: 12px; }
      .imagen-item { grid-template-columns: 64px 1fr; }
      .imagen-item img { width: 64px; height: 64px; }
    }

block content
  h1 Crear Publicacion
  form#form
    label(for='titulo') Titulo
    input#titulo(type='text' maxlength='50' required)
    label(for='descripcion') Descripcion
    textarea#descripcion(maxlength='255' required)
    label(for='imagen') Imagenes
    button#zonaImagen(type='button') Arrastra imagenes aqui o selecciona desde tu dispositivo
    input#imagen(type='file' accept='image/*' multiple)
    div#imagenesSeleccionadas
    label(for='etiqueta') Etiquetas
    div
      input#etiqueta(type='text' maxlength='50')
      button#agregarEtiqueta(type='button') Agregar etiqueta
    ul#listaEtiquetas
    button(type='submit') Crear publicacion

  script.
    const imagenes = [];
    const etiquetas = [];
    const zona = document.getElementById('zonaImagen');
    const inputFile = document.getElementById('imagen');
    const listaImagenes = document.getElementById('imagenesSeleccionadas');
    const listaEtiquetas = document.getElementById('listaEtiquetas');
    const form = document.getElementById('form');

    function procesarArchivos(archivos) {
      for (const imagen of archivos) {
        if (!imagen.type.startsWith('image/')) continue;
        const reader = new FileReader();
        reader.readAsDataURL(imagen);
        reader.onload = (ev) => {
          const item = { base64: ev.target.result, nombre: imagen.name, copyright: false, licencia: '', precio: null };
          imagenes.push(item);

          const tarjeta = document.createElement('div');
          tarjeta.className = 'imagen-item';
          const vista = document.createElement('img');
          vista.src = item.base64;
          vista.alt = imagen.name;
          const opciones = document.createElement('div');
          opciones.className = 'opciones-imagen';
          const nombre = document.createElement('strong');
          nombre.textContent = imagen.name;

          const copyrightLabel = document.createElement('label');
          const copyrightCheck = document.createElement('input');
          copyrightCheck.type = 'checkbox';
          copyrightLabel.append(copyrightCheck, ' Tiene licencia');
          const licencia = document.createElement('input');
          licencia.type = 'text';
          licencia.placeholder = 'Texto de la licencia';
          licencia.hidden = true;
          copyrightCheck.addEventListener('change', () => {
            item.copyright = copyrightCheck.checked;
            licencia.hidden = !copyrightCheck.checked;
          });
          licencia.addEventListener('input', () => { item.licencia = licencia.value; });

          const precioLabel = document.createElement('label');
          const precioCheck = document.createElement('input');
          precioCheck.type = 'checkbox';
          precioLabel.append(precioCheck, ' Asignar precio');
          const precio = document.createElement('input');
          precio.type = 'number';
          precio.min = '0';
          precio.step = '1';
          precio.placeholder = 'Precio';
          precio.hidden = true;
          precioCheck.addEventListener('change', () => {
            precio.hidden = !precioCheck.checked;
            precio.required = precioCheck.checked;
            item.precio = precioCheck.checked ? Number(precio.value) : null;
          });
          precio.addEventListener('input', () => {
            item.precio = precio.value === '' ? null : Number(precio.value);
          });

          opciones.append(nombre, copyrightLabel, licencia, precioLabel, precio);
          tarjeta.append(vista, opciones);
          listaImagenes.appendChild(tarjeta);
        };
      }
    }

    zona.addEventListener('click', () => inputFile.click());
    zona.addEventListener('dragover', (event) => {
      event.preventDefault();
      zona.classList.add('arrastrando');
    });
    zona.addEventListener('dragleave', () => zona.classList.remove('arrastrando'));
    zona.addEventListener('drop', (event) => {
      event.preventDefault();
      zona.classList.remove('arrastrando');
      procesarArchivos(event.dataTransfer.files);
    });
    inputFile.addEventListener('change', (event) => {
      procesarArchivos(event.target.files);
      inputFile.value = '';
    });

    document.getElementById('agregarEtiqueta').addEventListener('click', () => {
      const campo = document.getElementById('etiqueta');
      const etiqueta = campo.value.trim();
      if (!etiqueta || etiquetas.includes(etiqueta)) return;
      etiquetas.push(etiqueta);
      const elemento = document.createElement('li');
      elemento.textContent = etiqueta;
      listaEtiquetas.appendChild(elemento);
      campo.value = '';
    });

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!imagenes.length) return alert('Selecciona al menos una imagen');
      try {
        const res = await fetch('/CrearPublicacion', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            imagenes,
            titulo: document.getElementById('titulo').value,
            descripcion: document.getElementById('descripcion').value,
            etiquetas
          })
        });

        const data = await res.json();
        if (!res.ok || !data.ok) return alert(data.error || 'Hubo un error al crear la publicacion');
        window.location.replace('/welcome');
      } catch (err) {
        console.error('Error:', err);
        alert('No se pudo crear la publicacion');
      }
    });