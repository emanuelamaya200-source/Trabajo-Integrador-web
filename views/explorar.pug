extends ./layout

block content
    div.contenedor-explorar
        h1 Explorar Publicaciones
        
        if publicaciones && publicaciones.length > 0
            each post in publicaciones
                div.publicacion-card
                    div.autor-info
                        if post.creador
                            img.mini-foto(src=post.creador.foto_de_perfil alt=`Foto de ${post.creador.username}`)
                            span.autor-nombre= post.creador.username
                        else
                            img.mini-foto(src="/imagenes/default-avatar.png" alt="Anónimo")
                            span.autor-nombre Publicación Anónima
                    
                    div.contenido-post
                        h3
                            a.link-publicacion(href=`/verPublicacion/${post.id}`)= post.titulo
                        p= post.descripcion
                        if post.imagenes
                            each imagen in post.imagenes
                                if imagen.Precio !== null && imagen.Precio !== undefined
                                    p Precio: $#{Number(imagen.Precio).toLocaleString('es-AR')}
                    
                    div.fecha-post
                        span= new Date(post.createdAt).toLocaleDateString()
        else
            p No hay publicaciones para mostrar en este momento.