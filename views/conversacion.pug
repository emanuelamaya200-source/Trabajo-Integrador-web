extends ./layout

block content
    h1 Conversación con #{contacto.username}
    p
        a(href="/perfil/" + contacto.id) Ver perfil

    if mensajes.length > 0
        each mensaje in mensajes
            div
                strong= Number(mensaje.emisor_id) === Number(usuario.id) ? "Vos: " : `${contacto.username}: `
                span= mensaje.texto
                p= new Date(mensaje.createdAt).toLocaleString("es-AR")
    else
        p Todavía no hay mensajes.

    form(action=`/mensajes/${contacto.id}` method="POST")
        label(for="texto") Mensaje
        textarea#texto(name="texto" maxlength="1000" required)
        button(type="submit") Enviar
